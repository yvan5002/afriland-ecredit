<%- include('partials/entete') %>

<div class="hero">
  <svg class="hero-balance" viewBox="0 0 420 420" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g fill="none" stroke="#B4893F" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <!-- socle -->
      <path d="M160 380 L260 380 L235 355 L185 355 Z"/>
      <line x1="210" y1="355" x2="210" y2="60"/>
      <!-- fleau -->
      <circle cx="210" cy="60" r="7"/>
      <line x1="70" y1="90" x2="350" y2="90"/>
      <!-- chainettes + plateau gauche -->
      <line x1="90" y1="90" x2="55" y2="165"/>
      <line x1="90" y1="90" x2="125" y2="165"/>
      <path d="M40 165 A50 26 0 0 0 140 165"/>
      <!-- chainettes + plateau droit -->
      <line x1="330" y1="90" x2="295" y2="165"/>
      <line x1="330" y1="90" x2="365" y2="165"/>
      <path d="M280 165 A50 26 0 0 0 380 165"/>
    </g>
  </svg>
  <div class="eyebrow">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 3 7v2h18V7l-9-5Zm-7 9v8H8v-8H5Zm6 0v8h2v-8h-2Zm6 0v8h3v-8h-3ZM3 21h18v2H3v-2Z"/></svg>
    Service digital Afriland First Bank
  </div>
  <% if (enCours) { %>
    <div class="info-reprise" style="max-width:600px; margin:0 auto 20px;">
      Vous avez une demande de crédit en cours. <a href="/demande/continuer">Continuer ma demande →</a>
    </div>
  <% } %>
  <h1>Faites votre demande de crédit<br>sans vous déplacer en agence</h1>
  <p>Afriland E-Crédit vous permet de constituer et transmettre votre dossier de demande de crédit en ligne, en quelques minutes, où que vous soyez.</p>
  <a href="/demande" class="btn">Commencer ma demande →</a>

  <div class="cartes">
    <div class="carte">
      <div class="num">1</div>
      <h3>Vos informations</h3>
      <p>Renseignez votre identité et vos coordonnées</p>
    </div>
    <div class="carte">
      <div class="num">2</div>
      <h3>Votre demande</h3>
      <p>Montant, durée et objet du crédit souhaité</p>
    </div>
    <div class="carte">
      <div class="num">3</div>
      <h3>Vos documents</h3>
      <p>Déposez les 8 pièces exigées, au format PDF</p>
    </div>
  </div>
</div>

<%- include('partials/pied') %>
