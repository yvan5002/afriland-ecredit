<%- include('partials/entete') %>

<div class="container" style="max-width:960px;">

  <div class="agent-entete">
    <div>
      <h2 style="color:var(--red-dark); margin-bottom:4px;">Espace agent</h2>
      <p style="color:var(--ink-soft); font-size:13px;">Connecté(e) en tant que <strong><%= agentNom %></strong></p>
    </div>
    <form method="POST" action="/agent/deconnexion">
      <button type="submit" class="btn secondaire">Se déconnecter</button>
    </form>
  </div>

  <div class="agent-compteurs">
    <div class="compteur-item">
      <div class="compteur-chiffre"><%= compteurs.nouvelle %></div>
      <div class="compteur-label">À traiter</div>
    </div>
    <div class="compteur-item ok">
      <div class="compteur-chiffre"><%= compteurs.acceptee %></div>
      <div class="compteur-label">Acceptées</div>
    </div>
    <div class="compteur-item refus">
      <div class="compteur-chiffre"><%= compteurs.refusee %></div>
      <div class="compteur-label">Refusées</div>
    </div>
  </div>

  <div class="agent-onglets">
    <a href="/agent/tableau-bord" class="<%= vue === 'nouvelle' ? 'actif' : '' %>">Demandes à traiter</a>
    <a href="/agent/historique" class="<%= vue === 'historique' ? 'actif' : '' %>">Historique des décisions</a>
  </div>

  <% if (!demandes.length) { %>
    <div class="card" style="text-align:center; color:var(--ink-soft);">
      <% if (vue === 'nouvelle') { %>
        Aucune demande en attente pour le moment.
      <% } else { %>
        Aucune décision enregistrée pour le moment.
      <% } %>
    </div>
  <% } else { %>
    <div class="card" style="padding:0; overflow:hidden;">
      <table class="table-demandes">
        <thead>
          <tr>
            <th>Référence</th>
            <th>Client</th>
            <th>Montant</th>
            <th>Objet</th>
            <th>Date</th>
            <th>Statut</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% demandes.forEach(d => { %>
            <tr>
              <td class="mono"><%= d.reference %></td>
              <td><%= d.prenom %> <%= d.nom %></td>
              <td><%= Number(d.montant).toLocaleString('fr-FR') %> FCFA</td>
              <td><%= d.motif %></td>
              <td><%= new Date(d.date_soumission).toLocaleDateString('fr-FR') %></td>
              <td>
                <span class="badge badge-<%= d.statut %>">
                  <% if (d.statut === 'nouvelle') { %>À traiter<% } %>
                  <% if (d.statut === 'acceptee') { %>Acceptée<% } %>
                  <% if (d.statut === 'refusee') { %>Refusée<% } %>
                </span>
              </td>
              <td><a href="/agent/demande/<%= d.id %>" class="lien-voir">Voir →</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>

<%- include('partials/pied') %>
