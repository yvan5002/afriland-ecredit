<%- include('partials/entete') %>

<div class="container">
  <div class="card">
    <h2>Vos documents</h2>
    <p class="souscription">Étape 4 sur 5 — Dossier <strong><%= labelType %></strong>. Déposez un fichier <strong>PDF ou une photo (JPG/PNG)</strong> pour chacune des pièces exigées.</p>

    <div class="info-reprise" style="border-color:var(--gold);">
      Chaque document est vérifié automatiquement à l'envoi : assurez-vous de déposer le bon fichier au bon endroit.
    </div>

    <% if (erreur) { %><div class="erreur">⚠️ <%- erreur.split('\n').join('<br>') %></div><% } %>

    <form method="POST" action="/demande-entreprise/<%= type %>/documents" enctype="multipart/form-data">
      <% documents.forEach(doc => { %>
        <div class="doc-item">
          <div class="doc-num"><%= doc.numero %></div>
          <div class="doc-label"><%= doc.label %></div>
          <input type="file" name="<%= doc.cle %>" accept=".pdf,application/pdf,.jpg,.jpeg,.png,image/jpeg,image/png" required>
        </div>
      <% }) %>
      <div class="actions">
        <a href="/demande-entreprise/<%= type %>/choix-agent" class="btn secondaire">← Retour</a>
        <button type="submit" class="btn">Continuer →</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/pied') %>
