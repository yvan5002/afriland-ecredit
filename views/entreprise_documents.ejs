<%- include('partials/entete') %>

<div class="container">
  <div class="card">
    <h2>Vos documents</h2>
    <p class="souscription">
      Dossier <strong><%= labelType %></strong>. Déposez ce que vous avez sous la main —
      <strong>rien n'est obligatoire</strong>, vous pouvez envoyer votre dossier même incomplet
      et compléter plus tard avec votre agent.
    </p>

    <% if (erreur) { %><div class="erreur">⚠️ <%- erreur.split('\n').join('<br>') %></div><% } %>

    <form method="POST" action="/demande-entreprise/<%= type %>/documents" enctype="multipart/form-data">
      <% documents.forEach(doc => { %>
        <% const existant = documentsExistants && documentsExistants[doc.cle]; %>
        <div class="doc-item">
          <div class="doc-num"><%= doc.numero %></div>
          <div style="flex:1;">
            <div class="doc-label"><%= doc.label %></div>
            <input type="file" name="<%= doc.cle %>" accept=".pdf,application/pdf,.jpg,.jpeg,.png,image/jpeg,image/png" style="margin-top:6px;">
          </div>
          <% if (existant) { %>
            <span class="coche-bleue" title="Déjà déposé">✓</span>
          <% } %>
        </div>
      <% }) %>
      <div class="actions">
        <a href="/demande-entreprise/<%= type %>/choix-agent" class="btn secondaire">← Retour</a>
        <button type="submit" class="btn">Continuer →</button>
      </div>
    </form>
    <a href="/demande-entreprise/annuler" class="lien-annuler">Annuler ma demande</a>
  </div>
</div>

<%- include('partials/pied') %>
