<%- include('partials/entete') %>

<div class="container" style="max-width:720px;">
  <a href="<%= basePath %>/tableau-bord" class="lien-retour">← Retour au tableau de bord</a>

  <div class="card">
    <h2>Demande <%= demande.reference %></h2>
    <p class="souscription">
      Statut actuel :
      <span class="badge badge-<%= demande.statut === 'recommandee_acceptee' || demande.statut === 'recommandee_refusee' ? 'nouvelle' : demande.statut %>">
        <% if (demande.statut === 'nouvelle') { %>À traiter<% } %>
        <% if (demande.statut === 'acceptee') { %>Acceptée<% } %>
        <% if (demande.statut === 'refusee') { %>Refusée<% } %>
        <% if (demande.statut === 'recommandee_acceptee') { %>Recommandée (acceptation) — en attente du chef des PME<% } %>
        <% if (demande.statut === 'recommandee_refusee') { %>Recommandée (refus) — en attente du chef des PME<% } %>
      </span>
    </p>

    <% if (demande.type === 'particulier') { %>
      <h3 class="section-titre">Client</h3>
      <div class="recap-ligne"><span>Nom complet</span><span><%= demande.prenom %> <%= demande.nom %></span></div>
      <div class="recap-ligne"><span>Email</span><span><%= demande.email %></span></div>
      <div class="recap-ligne"><span>Téléphone</span><span><%= demande.telephone %></span></div>
      <div class="recap-ligne"><span>CNI</span><span><%= demande.cni %></span></div>
      <div class="recap-ligne"><span>Numéro de compte</span><span><%= demande.numero_compte %></span></div>

      <div class="verif-code-box">
        <strong>Vérification d'identité</strong>
        <div class="verif-resultat ok" style="margin-top:8px;">✅ Identité confirmée par code envoyé par email lors de la soumission.</div>
      </div>
    <% } else if (demande.type === 'pme') { %>
      <h3 class="section-titre">Entreprise (PME)</h3>
      <div class="recap-ligne"><span>Raison sociale</span><span><%= demande.raison_sociale || '—' %></span></div>
      <div class="recap-ligne"><span>Numéro de dossier</span><span><%= demande.numero_dossier || '—' %></span></div>
      <div class="recap-ligne"><span>Forme juridique</span><span><%= demande.forme_juridique || '—' %></span></div>
      <div class="recap-ligne"><span>RCCM</span><span><%= demande.rccm || '—' %></span></div>
      <div class="recap-ligne"><span>NIU</span><span><%= demande.niu_entreprise || '—' %></span></div>
      <div class="recap-ligne"><span>Adresse</span><span><%= demande.adresse || '—' %></span></div>
      <div class="recap-ligne"><span>Date de création</span><span><%= demande.date_creation_entreprise || '—' %></span></div>
      <div class="recap-ligne"><span>Type d'activité</span><span><%= demande.type_activite || '—' %></span></div>
      <div class="recap-ligne"><span>Capital</span><span><%= demande.capital || '—' %></span></div>
      <div class="recap-ligne"><span>Chiffre d'affaires</span><span><%= demande.chiffre_affaires || '—' %></span></div>
      <div class="recap-ligne"><span>Total Bilan</span><span><%= demande.total_bilan || '—' %></span></div>
      <div class="recap-ligne"><span>Effectif</span><span><%= demande.effectif || '—' %></span></div>
      <div class="recap-ligne"><span>Principaux fournisseurs</span><span><%= demande.principaux_fournisseurs || '—' %></span></div>
      <div class="recap-ligne"><span>Opération avec le compte</span><span><%= demande.operation_compte || '—' %></span></div>
      <div class="recap-ligne"><span>Origine des fonds</span><span><%= demande.origine_fonds || '—' %></span></div>
      <div class="recap-ligne"><span>Destination</span><span><%= demande.destination || '—' %></span></div>
      <div class="recap-ligne"><span>FATCA</span><span><%= demande.fatca || '—' %></span></div>
      <div class="recap-ligne"><span>Représentant</span><span><%= (demande.representant_prenom || demande.representant_nom) ? (demande.representant_prenom + ' ' + demande.representant_nom) : '—' %></span></div>
      <div class="recap-ligne"><span>Email</span><span><%= demande.email %></span></div>
      <div class="recap-ligne"><span>Téléphone</span><span><%= demande.telephone || '—' %></span></div>

      <div class="verif-code-box">
        <strong>Vérification d'identité</strong>
        <div class="verif-resultat ok" style="margin-top:8px;">✅ Email confirmé par code envoyé lors de la soumission.</div>
      </div>
    <% } else { %>
      <h3 class="section-titre">Entreprise (Corporate)</h3>
      <div class="recap-ligne"><span>Raison sociale</span><span><%= demande.raison_sociale %></span></div>
      <div class="recap-ligne"><span>RCCM</span><span><%= demande.rccm %></span></div>
      <div class="recap-ligne"><span>NIU entreprise</span><span><%= demande.niu_entreprise %></span></div>
      <div class="recap-ligne"><span>Secteur d'activité</span><span><%= demande.secteur_activite %></span></div>
      <div class="recap-ligne"><span>Représentant légal</span><span><%= demande.representant_prenom %> <%= demande.representant_nom %></span></div>
      <div class="recap-ligne"><span>Email</span><span><%= demande.email %></span></div>
      <div class="recap-ligne"><span>Téléphone</span><span><%= demande.telephone %></span></div>

      <div class="verif-code-box">
        <strong>Vérification d'identité</strong>
        <div class="verif-resultat ok" style="margin-top:8px;">✅ Email du représentant légal confirmé par code envoyé lors de la soumission.</div>
      </div>
    <% } %>

    <h3 class="section-titre">Demande de crédit</h3>
    <div class="recap-ligne"><span>Montant</span><span><%= demande.montant ? Number(demande.montant).toLocaleString('fr-FR') + ' FCFA' : '—' %></span></div>
    <% if (demande.duree) { %>
      <div class="recap-ligne"><span>Durée</span><span><%= demande.duree %> mois</span></div>
    <% } %>
    <div class="recap-ligne"><span>Objet</span><span><%= demande.motif || '—' %></span></div>
    <% if (demande.type === 'particulier') { %>
      <div class="recap-ligne"><span>Situation professionnelle</span><span><%= demande.situation %></span></div>
      <% if (demande.remboursement) { %>
        <div class="recap-ligne"><span>Taux annuel indicatif</span><span><%= demande.remboursement.tauxAnnuel %>%</span></div>
        <div class="recap-ligne"><span>Mensualité estimée</span><span><%= demande.remboursement.mensualite.toLocaleString('fr-FR') %> FCFA/mois</span></div>
        <div class="recap-ligne"><span>Coût total du crédit</span><span><%= demande.remboursement.coutTotalCredit.toLocaleString('fr-FR') %> FCFA (<%= demande.remboursement.pourcentageCout %>%)</span></div>
      <% } %>
    <% } %>
    <div class="recap-ligne"><span>Date de soumission</span><span><%= new Date(demande.date_soumission).toLocaleString('fr-FR') %></span></div>

    <% if (demande.score_risque_pourcentage !== null && demande.score_risque_pourcentage !== undefined) { %>
      <h3 class="section-titre">Évaluation automatique du risque</h3>
      <% const pct = demande.score_risque_pourcentage; %>
      <% const niveau = pct >= 60 ? 'ko' : (pct >= 30 ? 'attention' : 'ok'); %>
      <div class="verif-code-box">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
          <strong>Risque de défaut de paiement estimé</strong>
          <span class="verif-resultat <%= niveau === 'ko' ? 'ko' : 'ok' %>" style="font-size:18px;"><%= pct %>%</span>
        </div>
        <div class="barre-taux" style="margin-bottom:10px;">
          <div class="rempli" style="width:<%= pct %>%; background:<%= niveau === 'ko' ? 'linear-gradient(90deg, var(--red), var(--red-dark))' : (niveau === 'attention' ? 'linear-gradient(90deg, var(--gold), var(--gold-dark))' : 'linear-gradient(90deg, var(--green), #2E9A6E)') %>;"></div>
        </div>
        <% if (demande.score_risque_facteurs && demande.score_risque_facteurs.length) { %>
          <p style="font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:var(--gold-dark); margin-bottom:6px;">Facteurs qui pèsent le plus dans ce score</p>
          <ul style="margin:0; padding-left:18px; font-size:13px; color:var(--ink);">
            <% demande.score_risque_facteurs.forEach(f => { %>
              <li><%= f.nom %><% if (f.poids) { %> <span style="color:var(--ink-soft);">(<%= f.poids > 0 ? '+' : '' %><%= f.poids.toFixed(2) %>)</span><% } %></li>
            <% }) %>
          </ul>
        <% } %>
        <p style="font-size:11.5px; color:var(--ink-soft); margin-top:10px;">
          Estimation <% if (demande.type === 'pme') { %>indicative simplifiée<% } else { %>statistique<% } %> fournie à titre indicatif — elle n'est pas un motif automatique de refus, la décision finale reste la vôtre.
        </p>
      </div>
    <% } %>

    <% if (demande.type === 'particulier' && demande.identite_correspond !== null && demande.identite_correspond !== undefined) { %>
      <h3 class="section-titre">Vérification d'identité (photo vs CNI)</h3>
      <% if (demande.identite_score !== null && demande.identite_score < 0) { %>
        <div class="verif-resultat ko">⚠ Vérification automatique non disponible (caméra ou visage CNI illisible) — à vérifier manuellement.</div>
      <% } else if (demande.identite_correspond) { %>
        <div class="verif-resultat ok">✓ Le visage capturé correspond à la photo de la CNI<% if (demande.identite_score !== null) { %> (distance : <%= demande.identite_score %>)<% } %>.</div>
      <% } else { %>
        <div class="verif-resultat ko">⚠ Le visage capturé ne correspond pas à la photo de la CNI<% if (demande.identite_score !== null) { %> (distance : <%= demande.identite_score %>)<% } %> — à examiner attentivement.</div>
      <% } %>
    <% } %>

    <h3 class="section-titre">Pièces jointes</h3>
    <% const clesDocs = Object.keys(demande.documents || {}); %>
    <% if (!clesDocs.length) { %>
      <p style="font-size:13px; color:var(--ink-soft);">Aucun document déposé pour l'instant.</p>
    <% } else { %>
      <p style="font-size:12.5px; color:var(--ink-soft); margin-bottom:12px;">
        L'analyse automatique ci-dessous est <strong>indicative</strong> : elle vous aide à repérer un document
        manifestement incorrect, mais elle ne remplace pas votre propre vérification. Vous restez libre de vous y fier ou non.
      </p>
      <% clesDocs.forEach(cle => { %>
        <div class="doc-item">
          <div class="doc-num">📄</div>
          <div class="doc-label"><%= demande.documents[cle].libelle || demande.documents[cle].nom %></div>
          <% if (demande.documents[cle].verification === 'reconnu') { %>
            <span class="badge-verif ok">✓ Reconnu (IA)</span>
          <% } else { %>
            <span class="badge-verif attention">⚠ À vérifier</span>
          <% } %>
          <a href="<%= basePath %>/documents/<%= demande.id %>/<%= cle %>" target="_blank" class="lien-voir">Ouvrir →</a>
        </div>
      <% }) %>
    <% } %>

    <% if (demande.recommandation_agent_nom) { %>
      <h3 class="section-titre">Recommandation de l'agent</h3>
      <div class="verif-code-box">
        <div class="recap-ligne"><span>Agent</span><span><%= demande.recommandation_agent_nom %></span></div>
        <div class="recap-ligne"><span>Recommandation</span><span><%= demande.recommandation_decision === 'accepter' ? '✅ Acceptation' : '❌ Refus' %></span></div>
        <div class="recap-ligne"><span>Date</span><span><%= new Date(demande.recommandation_date).toLocaleString('fr-FR') %></span></div>
        <div class="recap-ligne"><span>Justification</span><span><%= demande.recommandation_commentaire %></span></div>
      </div>
    <% } %>

    <% if (demande.statut === 'nouvelle') { %>
      <h3 class="section-titre">Décision</h3>
      <% if (erreur) { %>
        <div class="erreur"><%= erreur %></div>
      <% } %>
      <p style="font-size:12.5px; color:var(--ink-soft); margin-bottom:10px;">
        Une justification écrite est <strong>obligatoire</strong>, que vous acceptiez ou refusiez cette demande
        (15 caractères minimum). Consultez les pièces jointes ci-dessus avant de vous décider.
      </p>
      <form method="POST" action="<%= basePath %>/demande/<%= demande.id %>/decider">
        <div class="champ">
          <label>Justification de votre décision (obligatoire)</label>
          <textarea name="commentaire" rows="3" placeholder="Ex : revenus suffisants au regard du montant demandé, dossier complet..." required minlength="15"></textarea>
        </div>
        <div class="actions">
          <button type="submit" name="decision" value="refuser" class="btn secondaire">Refuser</button>
          <button type="submit" name="decision" value="accepter" class="btn">Accepter</button>
        </div>
      </form>
    <% } else if (demande.statut === 'acceptee' || demande.statut === 'refusee') { %>
      <h3 class="section-titre">Décision <% if (demande.type === 'pme') { %>finale (chef des PME)<% } %>enregistrée</h3>
      <div class="recap-ligne"><span>Traité par</span><span><%= demande.traite_par_nom %></span></div>
      <div class="recap-ligne"><span>Date</span><span><%= new Date(demande.date_traitement).toLocaleString('fr-FR') %></span></div>
      <div class="recap-ligne"><span>Commentaire</span><span><%= demande.commentaire_decision %></span></div>
    <% } %>
  </div>
</div>

<%- include('partials/pied') %>
