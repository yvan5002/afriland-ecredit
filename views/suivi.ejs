<%- include('partials/entete') %>

<div class="container" style="max-width:460px;">
  <div class="card">
    <h2>Suivre ma demande</h2>
    <p class="souscription">Entrez le numéro de référence reçu lors de votre soumission.</p>

    <% if (erreur) { %>
      <div class="erreur"><%= erreur %></div>
    <% } %>

    <form method="POST" action="/suivi">
      <div class="champ">
        <label>Référence</label>
        <input type="text" name="reference" placeholder="AEC-202608-XXXXXX" style="text-transform:uppercase" required>
      </div>
      <button type="submit" class="btn" style="width:100%;">Consulter le statut</button>
    </form>
  </div>
</div>

<%- include('partials/pied') %>
