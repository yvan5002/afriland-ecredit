<%- include('partials/entete') %>

<div class="container">
  <div class="card">
    <h2>Vos documents</h2>
    <p class="souscription">Étape 3 sur 4 — Déposez un fichier <strong>PDF</strong> pour chacune des 8 pièces exigées.</p>
    <%- include('partials/progression', { actuel: 3 }) %>

    <% if (erreur) { %><div class="erreur">⚠️ <%= erreur %></div><% } %>

    <form method="POST" action="/demande/documents" enctype="multipart/form-data">
      <% documents.forEach(doc => { %>
        <div class="doc-item">
          <div class="doc-num"><%= doc.numero %></div>
          <div class="doc-label"><%= doc.label %></div>
          <input type="file" name="<%= doc.cle %>" accept=".pdf,application/pdf" required>
        </div>
      <% }) %>
      <div class="actions">
        <a href="/demande/pret" class="btn secondaire">← Retour</a>
        <button type="submit" class="btn">Continuer →</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/pied') %>
