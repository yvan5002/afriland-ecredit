<%- include('partials/entete') %>

<div class="container" style="max-width:420px;">
  <div class="card">
    <h2>Espace superviseur</h2>
    <p class="souscription">Vue d'ensemble du traitement des demandes de crédit.</p>

    <% if (erreur) { %>
      <div class="erreur"><%= erreur %></div>
    <% } %>

    <form method="POST" action="/superviseur/connexion">
      <div class="champ">
        <label>Identifiant</label>
        <input type="text" name="identifiant" required autofocus>
      </div>
      <div class="champ">
        <label>Mot de passe</label>
        <input type="password" name="mdp" required>
      </div>
      <button type="submit" class="btn" style="width:100%;">Se connecter</button>
    </form>
  </div>
</div>

<%- include('partials/pied') %>
