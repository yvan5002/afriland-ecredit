<%- include('partials/entete') %>

<div class="container" style="max-width:720px;">
  <a href="/directeur/tableau-bord" class="lien-retour">← Retour à la vue d'ensemble</a>

  <div class="card">
    <h2>Demande <%= demande.reference %></h2>
    <p class="souscription">
      Statut actuel :
      <span class="badge badge-<%= demande.statut %>">
        <% if (demande.statut === 'nouvelle') { %>À traiter<% } %>
        <% if (demande.statut === 'acceptee') { %>Acceptée<% } %>
        <% if (demande.statut === 'refusee') { %>Refusée<% } %>
      </span>
    </p>

    <h3 class="section-titre">Client</h3>
    <div class="recap-ligne"><span>Nom complet</span><span><%= demande.prenom %> <%= demande.nom %></span></div>
    <div class="recap-ligne"><span>Email</span><span><%= demande.email %></span></div>
    <div class="recap-ligne"><span>Téléphone</span><span><%= demande.telephone %></span></div>
    <div class="recap-ligne"><span>CNI</span><span><%= demande.cni %></span></div>
    <div class="recap-ligne"><span>Numéro de compte</span><span><%= demande.numero_compte %></span></div>

    <h3 class="section-titre">Demande de crédit</h3>
    <div class="recap-ligne"><span>Montant</span><span><%= Number(demande.montant).toLocaleString('fr-FR') %> FCFA</span></div>
    <div class="recap-ligne"><span>Durée</span><span><%= demande.duree %> mois</span></div>
    <div class="recap-ligne"><span>Objet</span><span><%= demande.motif %></span></div>
    <div class="recap-ligne"><span>Situation professionnelle</span><span><%= demande.situation %></span></div>
    <div class="recap-ligne"><span>Date de soumission</span><span><%= new Date(demande.date_soumission).toLocaleString('fr-FR') %></span></div>

    <h3 class="section-titre">Évaluation automatique du risque</h3>
    <% if (demande.score_risque_pourcentage === null || demande.score_risque_pourcentage === undefined) { %>
      <p style="font-size:13px; color:var(--ink-soft);">Aucune évaluation disponible pour ce dossier.</p>
    <% } else { %>
      <div class="recap-ligne"><span>Risque de défaut estimé</span><span><%= demande.score_risque_pourcentage %>%</span></div>
    <% } %>

    <h3 class="section-titre">Pièces jointes</h3>
    <p style="font-size:12.5px; color:var(--ink-soft); margin-bottom:12px;">
      Consultables en détail depuis l'espace gestionnaire — vue d'ensemble ici à titre indicatif.
    </p>
    <% Object.keys(demande.documents || {}).forEach(cle => { %>
      <div class="doc-item">
        <div class="doc-num">📄</div>
        <div class="doc-label"><%= demande.documents[cle].nom %></div>
        <% if (demande.documents[cle].verification === 'reconnu') { %>
          <span class="badge-verif ok">✓ Reconnu (IA)</span>
        <% } else { %>
          <span class="badge-verif attention">⚠ À vérifier</span>
        <% } %>
      </div>
    <% }) %>

    <% if (demande.statut !== 'nouvelle') { %>
      <h3 class="section-titre">Décision enregistrée</h3>
      <div class="recap-ligne"><span>Traité par</span><span><%= demande.gestionnaire_nom %></span></div>
      <div class="recap-ligne"><span>Date</span><span><%= new Date(demande.date_traitement).toLocaleString('fr-FR') %></span></div>
      <div class="recap-ligne"><span>Commentaire</span><span><%= demande.commentaire_gestionnaire %></span></div>
    <% } else { %>
      <div class="info-reprise" style="margin-top:20px;">En attente de décision par un gestionnaire.</div>
    <% } %>
  </div>
</div>

<%- include('partials/pied') %>
