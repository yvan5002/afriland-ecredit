<div class="etapes">
  <div class="etape <%= actuel >= 1 ? (actuel === 1 ? 'actif' : 'fait') : '' %>">
    <div class="rond"><%= actuel > 1 ? '✓' : '1' %></div><span>Informations</span>
  </div>
  <div class="etape <%= actuel >= 2 ? (actuel === 2 ? 'actif' : 'fait') : '' %>">
    <div class="rond"><%= actuel > 2 ? '✓' : '2' %></div><span>Vérification</span>
  </div>
  <div class="etape <%= actuel >= 3 ? (actuel === 3 ? 'actif' : 'fait') : '' %>">
    <div class="rond"><%= actuel > 3 ? '✓' : '3' %></div><span>Demande</span>
  </div>
  <div class="etape <%= actuel >= 4 ? (actuel === 4 ? 'actif' : 'fait') : '' %>">
    <div class="rond"><%= actuel > 4 ? '✓' : '4' %></div><span>Documents</span>
  </div>
  <div class="etape <%= actuel >= 5 ? 'actif' : '' %>">
    <div class="rond">5</div><span>Récapitulatif</span>
  </div>
</div>
