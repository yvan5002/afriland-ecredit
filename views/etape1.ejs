<%- include('partials/entete') %>

<div class="container">
  <div class="card">
    <h2>Vos informations personnelles</h2>
    <p class="souscription">Étape 1 sur 4 — Renseignez votre identité et vos coordonnées.</p>
    <%- include('partials/progression', { actuel: 1 }) %>

    <% if (reprise && donnees.nom) { %>
      <div class="info-reprise">
        Nous avons retrouvé une demande commencée précédemment — vos informations ont été pré-remplies.
        <a href="/demande/nouveau">Recommencer à zéro</a> si ce n'est pas la vôtre.
      </div>
    <% } %>

    <% if (erreur) { %><div class="erreur">⚠️ <%= erreur %></div><% } %>

    <form method="POST" action="/demande/etape1">
      <div class="grid2">
        <div class="champ">
          <label>Nom</label>
          <input type="text" name="nom" value="<%= donnees.nom || '' %>" required>
        </div>
        <div class="champ">
          <label>Prénom</label>
          <input type="text" name="prenom" value="<%= donnees.prenom || '' %>" required>
        </div>
      </div>
      <div class="grid2">
        <div class="champ">
          <label>Email</label>
          <input type="email" name="email" value="<%= donnees.email || '' %>" required>
        </div>
        <div class="champ">
          <label>Téléphone</label>
          <input type="text" name="telephone" maxlength="17" placeholder="+237 6XX XXX XXX" value="<%= donnees.telephone || '' %>" required>
        </div>
      </div>
      <div class="champ">
        <label>Numéro CNI (9 caractères)</label>
        <input type="text" name="cni" maxlength="9" style="text-transform:uppercase" value="<%= donnees.cni || '' %>" required>
      </div>
      <div class="champ">
        <label>Êtes-vous déjà client Afriland First Bank ?</label>
        <div class="radio-group">
          <label><input type="radio" name="client_existant" value="oui" id="client-oui" <%= (donnees.client_existant === 'non' || donnees.client_existant === 0) ? '' : 'checked' %>> Oui</label>
          <label><input type="radio" name="client_existant" value="non" id="client-non" <%= (donnees.client_existant === 'non' || donnees.client_existant === 0) ? 'checked' : '' %>> Non</label>
        </div>
      </div>

      <div id="bloc-client-existant">
        <div class="champ">
          <label>Numéro de compte Afriland (11 chiffres)</label>
          <input type="text" name="numero_compte" maxlength="11" placeholder="Ex : 12345678901" value="<%= donnees.numero_compte || '' %>">
        </div>
        <div class="champ">
          <label>Code de vérification (4 à 6 chiffres)</label>
          <input type="password" name="code_verification" maxlength="6" placeholder="Choisissez un code" inputmode="numeric">
          <p style="font-size:11.5px; color:var(--ink-soft); margin-top:6px;">
            Ce code n'est pas votre mot de passe bancaire. Il sert uniquement à confirmer votre identité :
            l'agent qui traitera votre dossier vous le redemandera par téléphone avant toute décision.
          </p>
        </div>
      </div>

      <div class="actions">
        <span></span>
        <button type="submit" class="btn">Continuer →</button>
      </div>
    </form>
  </div>
</div>

<script>
  const radios = document.querySelectorAll('input[name="client_existant"]');
  const bloc = document.getElementById('bloc-client-existant');
  function majBloc() {
    const oui = document.getElementById('client-oui').checked;
    bloc.style.display = oui ? 'block' : 'none';
    bloc.querySelectorAll('input').forEach(i => i.required = oui);
  }
  radios.forEach(r => r.addEventListener('change', majBloc));
  majBloc();
</script>

<%- include('partials/pied') %>
