<%- include('partials/entete') %>

<div class="container">
  <div class="card">
    <h2>Vos informations personnelles</h2>
    <p class="souscription">Étape 1 sur 5 — Renseignez votre identité et votre compte Afriland First Bank.</p>
    <%- include('partials/progression', { actuel: 1 }) %>

    <% if (reprise && donnees.nom) { %>
      <div class="info-reprise">
        Nous avons retrouvé une demande commencée précédemment — vos informations ont été pré-remplies.
        <a href="/demande/nouveau">Recommencer à zéro</a> si ce n'est pas la vôtre.
      </div>
    <% } %>

    <div class="info-reprise" style="border-color:var(--gold);">
      Un crédit ne peut être accordé qu'à un client déjà titulaire d'un compte Afriland First Bank.
      Votre email sera vérifié par un code envoyé automatiquement à l'étape suivante.
    </div>

    <% if (erreur) { %><div class="erreur">⚠️ <%= erreur %></div><% } %>

    <form method="POST" action="/demande/etape1">
      <div class="grid2">
        <div class="champ">
          <label>Nom</label>
          <input type="text" name="nom" value="<%= donnees.nom || '' %>" required>
        </div>
        <div class="champ">
          <label>Prénom</label>
          <input type="text" name="prenom" value="<%= donnees.prenom || '' %>" required>
        </div>
      </div>
      <div class="grid2">
        <div class="champ">
          <label>Email</label>
          <input type="email" name="email" value="<%= donnees.email || '' %>" required>
        </div>
        <div class="champ">
          <label>Téléphone</label>
          <input type="text" name="telephone" maxlength="17" placeholder="+237 6XX XXX XXX" value="<%= donnees.telephone || '' %>" required>
        </div>
      </div>
      <div class="champ">
        <label>Numéro CNI (9 caractères)</label>
        <input type="text" name="cni" maxlength="9" style="text-transform:uppercase" value="<%= donnees.cni || '' %>" required>
      </div>
      <div class="champ">
        <label>Numéro de compte Afriland (11 chiffres)</label>
        <input type="text" name="numero_compte" maxlength="11" placeholder="Ex : 12345678901" value="<%= donnees.numero_compte || '' %>" required>
      </div>

      <div class="actions">
        <span></span>
        <button type="submit" class="btn">Recevoir mon code de vérification →</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/pied') %>
